# Copy this file to .env.local for local-only configuration.
# Do not commit .env.local or real credentials.

# PostgreSQL connection string for Prisma CLI and server-only database access.
# Example: postgresql://USER:PASSWORD@localhost:5432/ai_avatar_outreach?schema=public
DATABASE_URL=""

# Public application URL used when sharing recipient links.
# Example: http://localhost:3000 for local testing.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gmail SMTP settings for real invitation emails. Use a Google App Password, not your normal password.
GMAIL_USER="your-gmail-address@gmail.com"
GMAIL_APP_PASSWORD=""
EMAIL_FROM="Avataar Outreach <your-gmail-address@gmail.com>"

# OpenAI server-side key for semantic conversation summaries. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=""
OPENAI_SUMMARY_MODEL="gpt-5.6-luna"

# Anam server-side credentials. Never prefix these with NEXT_PUBLIC_.
ANAM_API_KEY=""
ANAM_AVATAR_ID=""
ANAM_AVATAR_MODEL="cara-4"
ANAM_VOICE_ID=""
ANAM_LLM_ID=""
ANAM_PERSONA_NAME="Outreach Assistant"

# Future phases will document and validate ANAM_API_KEY, email-provider
# credentials, and application URLs here.
